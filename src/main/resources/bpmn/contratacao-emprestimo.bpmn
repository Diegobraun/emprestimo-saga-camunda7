<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_emprestimo" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="contratacao-emprestimo" name="Contratação de empréstimo" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="Inicio" name="Proposta recebida"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="AnalisarCredito" name="Analisar crédito" camunda:delegateExpression="${analisarCredito}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwDecisao" name="Decisão de crédito?" default="F5"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DesfechoRecusadaCredito" name="Registrar recusa" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">RECUSADA_CREDITO</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimRecusadaCredito" name="Recusada pelo crédito"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="RevisarProposta" name="Revisar proposta" camunda:candidateGroups="analistas"><bpmn:extensionElements><camunda:formData><camunda:formField id="aprovadoManualmente" label="Aprovar proposta" type="boolean" defaultValue="false" /><camunda:formField id="parecer" label="Parecer" type="string"><camunda:validation><camunda:constraint name="required" /></camunda:validation></camunda:formField></camunda:formData></bpmn:extensionElements><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GwAnalista" name="Analista aprovou?" default="F9"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DesfechoRecusadaAnalista" name="Registrar recusa" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">RECUSADA_ANALISTA</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimRecusadaAnalista" name="Recusada pelo analista"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwJuncao"><bpmn:incoming>F3</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReservarLimite" name="Reservar limite" camunda:delegateExpression="${reservarLimite}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GerarContrato" name="Gerar contrato" camunda:delegateExpression="${gerarContrato}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:receiveTask id="AguardarAssinatura" name="Aguardar assinatura" messageRef="Msg_ContratoAssinado"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:serviceTask id="Desembolsar" name="Desembolsar" camunda:delegateExpression="${desembolsar}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="AtivarContrato" name="Ativar contrato" camunda:delegateExpression="${ativarContrato}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R5/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="DesfechoContratado" name="Registrar contratação" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">CONTRATADO</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimContratado" name="Empréstimo contratado"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="DesfechoSemLimite" name="Registrar recusa" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">RECUSADA_LIMITE</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimSemLimite" name="Sem limite"><bpmn:incoming>F19</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CompensarContratoRecusado" name="Desfazer reserva"><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing><bpmn:compensateEventDefinition id="CompensarContratoRecusado_def" /></bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="DesfechoContratoRecusado" name="Registrar recusa do contrato" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">RECUSADA_CONTRATO</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimContratoRecusado" name="Contrato recusado"><bpmn:incoming>F28</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CompensarExpirada" name="Desfazer reserva e contrato"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:compensateEventDefinition id="CompensarExpirada_def" /></bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="DesfechoExpirada" name="Registrar expiração" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">EXPIRADA</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimExpirada" name="Assinatura expirada"><bpmn:incoming>F22</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="CompensarCancelada" name="Desfazer reserva e contrato"><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:compensateEventDefinition id="CompensarCancelada_def" /></bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="DesfechoCancelada" name="Registrar cancelamento" camunda:delegateExpression="${registrarDesfecho}" camunda:asyncBefore="true"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="desfecho">CANCELADA_DESEMBOLSO</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="FimCancelada" name="Cancelada"><bpmn:incoming>F25</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="LiberarLimite" name="Liberar limite" isForCompensation="true" camunda:delegateExpression="${liberarLimite}"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R5/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="CancelarContrato" name="Cancelar contrato" isForCompensation="true" camunda:delegateExpression="${cancelarContrato}"><bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R5/PT3S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:boundaryEvent id="ErroLimite" name="Limite insuficiente" attachedToRef="ReservarLimite"><bpmn:outgoing>F18</bpmn:outgoing><bpmn:errorEventDefinition id="ErroLimite_def" errorRef="Err_LimiteInsuficiente" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="CompReserva" attachedToRef="ReservarLimite"><bpmn:compensateEventDefinition id="CompReserva_def" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ErroContrato" name="Contrato recusado" attachedToRef="GerarContrato"><bpmn:outgoing>F26</bpmn:outgoing><bpmn:errorEventDefinition id="ErroContrato_def" errorRef="Err_ContratoRecusado" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="CompContrato" attachedToRef="GerarContrato"><bpmn:compensateEventDefinition id="CompContrato_def" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="PrazoAssinatura" name="Prazo esgotado" attachedToRef="AguardarAssinatura"><bpmn:outgoing>F20</bpmn:outgoing><bpmn:timerEventDefinition id="PrazoAssinatura_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${prazoAssinatura}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ErroDesembolso" name="Desembolso recusado" attachedToRef="Desembolsar"><bpmn:outgoing>F23</bpmn:outgoing><bpmn:errorEventDefinition id="ErroDesembolso_def" errorRef="Err_DesembolsoRecusado" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="AnalisarCredito" />
    <bpmn:sequenceFlow id="F2" sourceRef="AnalisarCredito" targetRef="GwDecisao" />
    <bpmn:sequenceFlow id="F3" name="aprovada" sourceRef="GwDecisao" targetRef="GwJuncao"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoCredito == 'APROVADA'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="recusada" sourceRef="GwDecisao" targetRef="DesfechoRecusadaCredito"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoCredito == 'RECUSADA'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="revisão" sourceRef="GwDecisao" targetRef="RevisarProposta" />
    <bpmn:sequenceFlow id="F6" sourceRef="DesfechoRecusadaCredito" targetRef="FimRecusadaCredito" />
    <bpmn:sequenceFlow id="F7" sourceRef="RevisarProposta" targetRef="GwAnalista" />
    <bpmn:sequenceFlow id="F8" name="sim" sourceRef="GwAnalista" targetRef="GwJuncao"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprovadoManualmente}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" name="não" sourceRef="GwAnalista" targetRef="DesfechoRecusadaAnalista" />
    <bpmn:sequenceFlow id="F10" sourceRef="DesfechoRecusadaAnalista" targetRef="FimRecusadaAnalista" />
    <bpmn:sequenceFlow id="F11" sourceRef="GwJuncao" targetRef="ReservarLimite" />
    <bpmn:sequenceFlow id="F12" sourceRef="ReservarLimite" targetRef="GerarContrato" />
    <bpmn:sequenceFlow id="F13" sourceRef="GerarContrato" targetRef="AguardarAssinatura" />
    <bpmn:sequenceFlow id="F14" sourceRef="AguardarAssinatura" targetRef="Desembolsar" />
    <bpmn:sequenceFlow id="F15" sourceRef="Desembolsar" targetRef="AtivarContrato" />
    <bpmn:sequenceFlow id="F16" sourceRef="AtivarContrato" targetRef="DesfechoContratado" />
    <bpmn:sequenceFlow id="F17" sourceRef="DesfechoContratado" targetRef="FimContratado" />
    <bpmn:sequenceFlow id="F18" sourceRef="ErroLimite" targetRef="DesfechoSemLimite" />
    <bpmn:sequenceFlow id="F19" sourceRef="DesfechoSemLimite" targetRef="FimSemLimite" />
    <bpmn:sequenceFlow id="F26" sourceRef="ErroContrato" targetRef="CompensarContratoRecusado" />
    <bpmn:sequenceFlow id="F27" sourceRef="CompensarContratoRecusado" targetRef="DesfechoContratoRecusado" />
    <bpmn:sequenceFlow id="F28" sourceRef="DesfechoContratoRecusado" targetRef="FimContratoRecusado" />
    <bpmn:sequenceFlow id="F20" sourceRef="PrazoAssinatura" targetRef="CompensarExpirada" />
    <bpmn:sequenceFlow id="F21" sourceRef="CompensarExpirada" targetRef="DesfechoExpirada" />
    <bpmn:sequenceFlow id="F22" sourceRef="DesfechoExpirada" targetRef="FimExpirada" />
    <bpmn:sequenceFlow id="F23" sourceRef="ErroDesembolso" targetRef="CompensarCancelada" />
    <bpmn:sequenceFlow id="F24" sourceRef="CompensarCancelada" targetRef="DesfechoCancelada" />
    <bpmn:sequenceFlow id="F25" sourceRef="DesfechoCancelada" targetRef="FimCancelada" />
    <bpmn:association id="A1" associationDirection="One" sourceRef="CompReserva" targetRef="LiberarLimite" />
    <bpmn:association id="A2" associationDirection="One" sourceRef="CompContrato" targetRef="CancelarContrato" />
  </bpmn:process>
